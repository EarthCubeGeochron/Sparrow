@import './colors'
@import './color-aliases'
@import "@blueprintjs/datetime/lib/css/blueprint-datetime.css"

*
  box-sizing: border-box

:root
  --panel-background-secondary: $light-gray4
  --subtle-background: $light-gray5
  --card-hover: $light-gray5
  --active-highlight: $light-gray3
  --text-color-muted: $bp4-text-color-muted
  --text-color-dim: $bp4-text-color-disabled
  --background-color: white


page_margin=2em

body
  margin 0
  padding 0
  min-height: 100vh
  &.bp4-dark
    --active-highlight: $gray1
    --panel-background-secondary: $dark-gray5
    --subtle-background: $dark-gray3
    --card-hover: $dark-gray5
    --text-color-muted: $bp4-dark-text-color-muted
    --text-color-dim: $bp4-dark-text-color-disabled
    --background-color: $dark-gray2
    background-color: $dark-gray2

h1.site-title
  color $gray1
  font-size 1.2em
  span.subtitle, span.inner
    display: inline-block
    margin-left 0.3em
  span.subtitle
    color: $gray1
  span.subpage
    color: $gray1

nav.site-nav ul
  display flex
  flex-direction row
  margin 0.5em 0 1em
  list-style none
  padding-left 0
  li
    margin-right 1em
    a
      font-size 1.2em

div.api-result-placeholder
  padding 2em 4em
  flex-grow 1
  display flex
  justify-content center
  align-items center

.bp4-dark .api-explorer-v2
  background-color: $dark-gray2
  color: $bp4-dark-text-color

  .swagger-ui
    color: $bp4-dark-text-color

    .info
      .title,
      h1,
      h2,
      h3,
      h4,
      h5,
      h6
        color: $bp4-dark-heading-color

      p,
      li,
      table,
      label,
      span,
      code,
      pre,
      .base-url,
      .markdown p
        color: $bp4-dark-text-color

      a
        color: $bp4-dark-link-color

    .opblock-tag,
    .opblock-summary-path,
    .opblock-summary-path a,
    .opblock-summary-path span,
    .opblock-summary-description,
    .parameter__name,
    .parameter__type,
    .response-col_status,
    .response-col_description,
    .tab li,
    .model-title,
    .model
      color: $bp4-dark-text-color

    .scheme-container,
    .opblock,
    .model-box,
    section.models
      background: $dark-gray3

div.api-explorer-v2
  margin-top 1em
  .swagger-ui .info
    margin-top 1em

  .swagger-ui .opblock .opblock-summary
    align-items: center
    gap: 0.5em

  .swagger-ui .opblock .opblock-summary-method
    flex: 0 0 86px

  .swagger-ui .opblock .opblock-summary-path
    flex: 0 1 34rem
    max-width: 34rem
    min-width: 16rem
    overflow-wrap: anywhere
    padding: 0.3em 0.5em
    white-space: normal
    word-break: normal

  .swagger-ui .opblock .opblock-summary-path a,
  .swagger-ui .opblock .opblock-summary-path span
    overflow-wrap: anywhere
    white-space: normal

  .swagger-ui .opblock .opblock-summary-description
    flex: 1 1 12rem
    min-width: 10rem

  .swagger-ui .opblock .opblock-summary svg
    flex: 0 0 auto
    margin-left: auto

  @media (max-width: 700px)
    .swagger-ui .opblock .opblock-summary
      flex-wrap: wrap

    .swagger-ui .opblock .opblock-summary-path
      flex: 1 1 calc(100% - 120px)
      max-width: none
      min-width: 0

    .swagger-ui .opblock .opblock-summary-description
      flex-basis: 100%
      min-width: 0

.flex-container
  display flex
  flex-direction row
  align-items: baseline
  &>*
    margin-right 1em
    vertical-align: baseline
    margin-bottom 0
    margin-top 0
    &:last-child
      margin-right 0
    &.spacer
      flex-grow 1

footer
  margin-bottom 1em

